{
    "version": 2,
    "builds": [
          {
                  "src": "server.js",
                  "use": "@vercel/node"
          }
    ],
    "routes": [
          {
                  "src": "/(.*)",
                  "dest": "server.js"
          }
    ],
    "crons": [
          {
                  "path": "/admin/send-report-cron",
                  "schedule": "0 21 * * *"
          }
    ]
}
